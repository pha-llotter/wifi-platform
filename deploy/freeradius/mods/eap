# EAP-TTLS only. Google can only check a plain password (an LDAP bind), so devices
# send it with PAP inside a TLS tunnel to this server. PEAP-MSCHAPv2 can't work with
# Google, so it isn't offered; clients that ask for it are told to use TTLS.
eap {
	default_eap_type = ttls
	timer_expire = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no
	max_sessions = ${max_requests}

	# The server certificate devices check: a public one (Let's Encrypt via Caddy) for
	# the RADIUS name, copied into place by run.sh.
	tls-config tls-common {
		private_key_file = ${certdir}/server.key
		certificate_file = ${certdir}/server.pem
		ca_path = /etc/ssl/certs
		cipher_list = "DEFAULT"
		cipher_server_preference = yes
		# TLS 1.3 inside EAP-TTLS still trips up some Windows and Android versions.
		tls_min_version = "1.2"
		tls_max_version = "1.2"
		ecdh_curve = ""
		cache {
			enable = no
		}
		verify {
		}
		ocsp {
			enable = no
		}
	}

	# Required by ttls.default_eap_type; only plain PAP is actually used inside the tunnel.
	md5 {
	}

	ttls {
		tls = tls-common
		default_eap_type = md5
		copy_request_to_tunnel = no
		use_tunneled_reply = no
		virtual_server = "inner-tunnel"
	}
}
