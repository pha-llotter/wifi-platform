# What the vSZ talks to. The school networks are open Hotspot (WISPr) WLANs with the
# platform's sign-in page, so a login here is one of:
#  - a sign-in from that page: User-Name = the email, User-Password = a one-time ticket
#  - a returning device (MAC authentication): User-Name = User-Password = its MAC
# Both are decided by the platform (POST /radius/portal). EAP (802.1X) is still handled
# by the inner-tunnel server, for a WLAN that uses it.
server default {
	listen {
		type = auth
		ipaddr = *
		port = 1812
	}

	listen {
		type = acct
		ipaddr = *
		port = 1813
	}

	authorize {
		filter_username
		preprocess
		eap {
			ok = return
		}
		# Hotspot logins arrive with a plain (PAP) password; CHAP and the rest are refused.
		if (&User-Password) {
			platform_portal {
				fail = 1
			}
			if (ok || updated) {
				update control {
					&Auth-Type := Accept
				}
				return
			}
		}
		reject
	}

	authenticate {
		eap
	}

	preacct {
		preprocess
		acct_unique
	}

	# The vSZ reports each session's start, regular updates and stop with the bytes used.
	# They go to the platform for the Usage page; the vSZ is always answered, even if
	# the platform can't be reached.
	accounting {
		platform {
			fail = 1
		}
		ok
	}

	post-auth {
		# The VLAN and session length the inner tunnel decided.
		update {
			&reply: += &session-state:
		}
		remove_reply_message_if_eap

		Post-Auth-Type REJECT {
			attr_filter.access_reject
			eap
			remove_reply_message_if_eap
		}
	}
}
