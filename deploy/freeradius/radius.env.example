# FreeRADIUS settings. Copy to /etc/wifi-portal/radius.env and fill in.

# The vSZ: the address its RADIUS packets arrive from (the school's public IP) and the
# shared secret set on the vSZ's RADIUS service. Use 32+ random characters.
VSZ_ADDRESS=203.0.113.10
RADIUS_SECRET=change-me-to-a-long-random-secret

# Bare usernames ("t.smith") get this domain added.
DEFAULT_DOMAIN=phahs.org.za

# Google Secure LDAP. The client certificate and key come from the Admin console
# (Apps → LDAP → your client → Download certificate) and live in /etc/wifi-portal/google-ldap/.
LDAP_SERVER=ldaps://ldap.google.com
LDAP_PORT=636
LDAP_BASE_DN=dc=phahs,dc=org,dc=za
LDAP_CLIENT_CERT=/google/ldap-client.crt
LDAP_CLIENT_KEY=/google/ldap-client.key
LDAP_REQUIRE_CERT=demand

# The WiFi platform's local API. PLATFORM_TOKEN must equal radius.apiToken in config.json.
PLATFORM_URL=http://127.0.0.1:8080
PLATFORM_TOKEN=change-me-to-the-same-random-token-as-config-json

# The certificate devices see when they log in. Caddy gets it for radius.phahs.org.za.
TLS_CERT=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/radius.phahs.org.za/radius.phahs.org.za.crt
TLS_KEY=/caddy/caddy/certificates/acme-v02.api.letsencrypt.org-directory/radius.phahs.org.za/radius.phahs.org.za.key

# If the platform can't be reached: empty refuses all logins until it's back; a VLAN
# number lets anyone with a correct Google password on to that VLAN (blocks and
# rules are skipped while it's down). A restricted student VLAN is a sensible choice.
FALLBACK_VLAN=

# Set to 1 to log every request in detail while setting up.
RADIUS_DEBUG=0
